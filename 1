local function updateMenuTheme(newAccentColor)
    Theme.Primary = newAccentColor
    for _, obj in ipairs(ThemeObjects.Accents) do
        if obj and obj.Parent then
            if obj:IsA("Frame") or obj:IsA("TextButton") then
                obj.BackgroundColor3 = newAccentColor
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                obj.TextColor3 = newAccentColor
            elseif obj:IsA("ImageLabel") then
                obj.ImageColor3 = newAccentColor
            end
        end
    end
    for _, stroke in ipairs(ThemeObjects.Strokes) do
        if stroke and stroke.Parent then
            stroke.Color = newAccentColor
        end
    end
    if shared.nyxFovCircle then
        shared.nyxFovCircle.Color = newAccentColor
    end
end

