local args = {...}
local originPos, hitPos
for _, arg in ipairs(args) do
if typeof(arg) == "Vector3" then
if not originPos then originPos = arg else hitPos = arg break end
elseif typeof(arg) == "table" and arg.origin then
originPos = arg.origin
hitPos = arg.hit or arg.finish or arg.stop
end
end
-- Валидация выстрела локального игрока
if originPos and hitPos and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
local distFromMe = (originPos - LocalPlayer.Character.Head.Position).Magnitude
