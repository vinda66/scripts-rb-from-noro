_G.currentTab = "Combat"
local function showTab(tabName)
    _G.currentTab = tabName
    for name, page in pairs(Pages) do page.Visible = (name == tabName) end
    for _, btn in ipairs(Sidebar:GetChildren()) do
        if btn:IsA("TextButton") then
            if btn.Name == tabName .. "TabBtn" then
                btn.BackgroundColor3 = Color3.fromRGB(35, 25, 55)
                btn.BackgroundTransparency = 0
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                btn.BackgroundTransparency = 1
                btn.TextColor3 = Theme.TextSub
            end
        end
    end
    if shared.nyxFovCircle then
        shared.nyxFovCircle.Visible = (tabName == "Combat") and _G.aimbotToggle and MainFrame.Visible
    end
end

local isMenuOpen = true
local isTweening = false
local lastSavedPos = MainFrame.Position

local function toggleMenuVisuals(open)
    if isTweening then return end
    isTweening = true
    local tInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    if open then
        MainFrame.Visible = true
        if shared.nyxFovCircle then shared.nyxFovCircle.Visible = (_G.currentTab == "Combat") and _G.aimbotToggle end
        TweenService:Create(MainFrame, tInfo, {Size = UDim2.new(0, 550, 0, 390), Position = lastSavedPos, BackgroundTransparency = 0}):Play()
        task.wait(0.35)
        isMenuOpen = true
    else
        if shared.nyxFovCircle then shared.nyxFovCircle.Visible = false end
        lastSavedPos = MainFrame.Position
        local collapse = TweenService:Create(MainFrame, tInfo, {Size = UDim2.new(0, 0, 0, 0), Position = InfoBarFrame.Position, BackgroundTransparency = 1})
        collapse:Play()
        collapse.Completed:Wait()
        MainFrame.Visible = false
        isMenuOpen = false
    end
    isTweening = false
end

UserInputService.InputBegan:Connect(function(input, gp)
    if not gp and input.KeyCode == Enum.KeyCode.RightControl then toggleMenuVisuals(not isMenuOpen) end
end)

