laserPart.Transparency = 0              -- Начальная максимальная яркость
laserPart.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
laserPart.Parent = workspace
-- ИСПРАВЛЕНИЕ: Одновременное сужение луча и вывод прозрачности в 1 (полное растворение)
local fadeTween = TweenService:Create(laserPart, TweenInfo.new(0.45, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
Size = Vector3.new(0, 0, distance),
Transparency = 1
})
fadeTween:Play()
-- Чистим объект из оперативной памяти
game:GetService("Debris"):AddItem(laserPart, 0.45)
end
-- Сетевой перехват
local remotesFolder = game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 5)
