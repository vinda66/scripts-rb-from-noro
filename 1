-- VISUALS: БЕЗОПАСНЫЙ ХУК ТРАССЕРОВ ПУЛЬ
local bulletTracersToggle = false
local function drawMyOwnLaser(startPos, endPos)
    local distance = (endPos - startPos).Magnitude
    if distance > 1000 or distance < 2 then return end

    local laserPart = Instance.new("Part")
    laserPart.Anchored = true
    laserPart.CanCollide = false
    laserPart.Material = Enum.Material.Neon
    laserPart.Color = Theme.Primary
    laserPart.Size = Vector3.new(0.08, 0.08, distance)
    laserPart.CFrame = CFrame.new(startPos, endPos) * CFrame.new(0, 0, -distance / 2)
    laserPart.Parent = workspace

    TweenService:Create(laserPart, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(0, 0, distance), Transparency = 1
    }):Play()
    game:GetService("Debris"):AddItem(laserPart, 0.35)
end

-- Хукаем RemoteEvent эффектов из папки Remotes
task.spawn(function()
    local remotes = game:GetService("ReplicatedStorage"):WaitForChild("Remotes", 10)
    local effectEvent = remotes and remotes:WaitForChild("Effect", 10)
    
    if effectEvent and effectEvent:IsA("RemoteEvent") then
        effectEvent.OnClientEvent:Connect(function(effectType, data)
            if not bulletTracersToggle or not data or typeof(data) ~= "table" then return end
            
            -- Проверяем тип эффекта (в Walker Engine эффекты выстрелов обычно передают origin/start)
            local startPos = data.Origin or data.Start or data.Position
            local endPos = data.Finish or data.Hit or data.End
            
            if startPos and endPos and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
                -- Фильтр: Проверяем, спавнится ли пуля в упор от нашего персонажа
                local distFromMe = (startPos - LocalPlayer.Character.Head.Position).Magnitude
                if distFromMe < 12 then
                    task.spawn(drawMyOwnLaser, startPos, endPos)
                end
            end
        end)
    end
end)

