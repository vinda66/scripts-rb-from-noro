_G.currentTab = "Combat"
local function showTab(tabName)
    _G.currentTab = tabName
    for name, page in pairs(Pages) do page.Visible = (name == tabName) end
    for _, btn in ipairs(Sidebar:GetChildren()) do
        if btn:IsA("TextButton") then
            if btn.Name == tabName .. "TabBtn" then
                TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.2}):Play()
                btn.TextColor3 = Theme.TextWhite
            else
                TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = Color3.fromRGB(0,0,0), BackgroundTransparency = 1}):Play()
                btn.TextColor3 = Theme.TextMuted
            end
        end
    end
end

-- АНИМАЦИЯ СВОРАЧИВАНИЯ В СТАТУС-ПОЛОСКУ
local isMenuOpen = true
local isTweening = false
local normalSize = UDim2.new(0, 540, 0, 380)
local normalPos = UDim2.new(0.3, 0, 0.25, 0)

local function toggleMenuVisuals(open)
    if isTweening then return end
    isTweening = true
    local tInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    if open then
        -- Разворачиваем меню, убираем полоску в верх экрана
        TweenService:Create(TopBar, tInfo, {Size = UDim2.new(0, 0, 0, 30), Position = UDim2.new(0.5, 0, 0, -40)}):Play()
        task.wait(0.1)
        MainFrame.Visible = true
        if shared.nyxFovCircle then shared.nyxFovCircle.Visible = (_G.currentTab == "Combat") and _G.aimbotToggle end
        TweenService:Create(MainFrame, tInfo, {Size = normalSize, Position = normalPos, BackgroundTransparency = 0}):Play()
        TweenService:Create(Sidebar, tInfo, {BackgroundTransparency = 0}):Play()
        TweenService:Create(FixFrame, tInfo, {BackgroundTransparency = 0}):Play()
        task.wait(0.4)
        isMenuOpen = true
    else
        -- Сворачиваем меню в полоску вверху экрана
        if shared.nyxFovCircle then shared.nyxFovCircle.Visible = false end
        local targetCenter = UDim2.new(0.5, 0, 0, 10)
        TweenService:Create(MainFrame, tInfo, {Size = UDim2.new(0, 0, 0, 0), Position = targetCenter, BackgroundTransparency = 1}):Play()
        TweenService:Create(Sidebar, tInfo, {BackgroundTransparency = 1}):Play()
        TweenService:Create(FixFrame, tInfo, {BackgroundTransparency = 1}):Play()
        task.wait(0.3)
        MainFrame.Visible = false
        
        -- Выезжает аккуратная полоска сверху
        TopBar.Position = UDim2.new(0.5, -280, 0, -40)
        TweenService:Create(TopBar, tInfo, {Size = UDim2.new(0, 560, 0, 30), Position = UDim2.new(0.5, -280, 0, 15)}):Play()
        task.wait(0.4)
        isMenuOpen = false
    end
    isTweening = false
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.RightControl then toggleMenuVisuals(not isMenuOpen) end
end)

local tabCount = 0
local function createTabButton(name, iconText)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "TabBtn"; btn.Parent = Sidebar; btn.Size = UDim2.new(1, -16, 0, 36); btn.Position = UDim2.new(0, 8, 0, 65 + (tabCount * 42))
    btn.BackgroundColor3 = Color3.fromRGB(0,0,0); btn.BackgroundTransparency = 1; btn.Text = "  " .. iconText .. "   " .. name
    btn.TextColor3 = Theme.TextMuted; btn.Font = Enum.Font.GothamBold; btn.TextSize = 12; btn.TextXAlignment = Enum.TextXAlignment.Left; addCorners(btn, 6)
    
    btn.MouseEnter:Connect(function() if _G.currentTab ~= name then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.9, BackgroundColor3 = Theme.Accent, TextColor3 = Theme.TextWhite}):Play() end end)
    btn.MouseLeave:Connect(function() if _G.currentTab ~= name then TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 1, TextColor3 = Theme.TextMuted}):Play() end end)
    btn.MouseButton1Click:Connect(function() showTab(name) end)
    tabCount = tabCount + 1
end

