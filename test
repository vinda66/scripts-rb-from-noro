-- КОНСТРУКТОР ТУМБЛЕРОВ С БЕЛОЙ АНИМАЦИЕЙ
local isDarkBorderEnabled = false
local function createHazeToggle(text, tabContainer, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 42); frame.BackgroundColor3 = Color3.fromRGB(18, 16, 24); frame.Parent = tabContainer; addCorners(frame, 6)
    local frameStroke = addStroke(frame, Color3.fromRGB(35, 32, 45), 1)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 1, 0); label.Position = UDim2.new(0, 10, 0, 0); label.BackgroundTransparency = 1; label.Text = text
    label.TextColor3 = Color3.fromRGB(200, 195, 210); label.Font = Enum.Font.GothamSemibold; label.TextSize = 13; label.TextXAlignment = Enum.TextXAlignment.Left; label.Parent = frame

    local toggleBg = Instance.new("TextButton")
    toggleBg.Size = UDim2.new(0, 38, 0, 20); toggleBg.Position = UDim2.new(1, -48, 0.5, -10); toggleBg.BackgroundColor3 = Color3.fromRGB(32, 30, 42); toggleBg.Text = ""; toggleBg.Parent = frame; addCorners(toggleBg, 10)
    local toggleStroke = addStroke(toggleBg, Color3.fromRGB(55, 50, 70), 1)

    local ball = Instance.new("Frame")
    ball.Size = UDim2.new(0, 14, 0, 14); ball.Position = UDim2.new(0, 3, 0.5, -7); ball.BackgroundColor3 = Color3.fromRGB(140, 135, 155); ball.Parent = toggleBg; addCorners(ball, 7)

    local state = false
    local function updateVisuals(isHovering)
        local tInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        if isHovering then
            TweenService:Create(label, tInfo, {TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(frame, tInfo, {BackgroundColor3 = Color3.fromRGB(25, 22, 34)}):Play()
            TweenService:Create(frameStroke, tInfo, {Color = isDarkBorderEnabled and Theme.DarkBorder or Theme.Accent}):Play()
            if not state then
                TweenService:Create(toggleBg, tInfo, {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
                TweenService:Create(toggleStroke, tInfo, {Color = Color3.fromRGB(255, 255, 255)}):Play()
                TweenService:Create(ball, tInfo, {BackgroundColor3 = Color3.fromRGB(20, 20, 25)}):Play()
            else
                TweenService:Create(toggleStroke, tInfo, {Color = Color3.fromRGB(255, 255, 255)}):Play()
            end
        else
            TweenService:Create(label, tInfo, {TextColor3 = Color3.fromRGB(200, 195, 210)}):Play()
            TweenService:Create(frame, tInfo, {BackgroundColor3 = Color3.fromRGB(18, 16, 24)}):Play()
            TweenService:Create(frameStroke, tInfo, {Color = Color3.fromRGB(35, 32, 45)}):Play()
            if not state then
                TweenService:Create(toggleBg, tInfo, {BackgroundColor3 = Color3.fromRGB(32, 30, 42)}):Play()
                TweenService:Create(toggleStroke, tInfo, {Color = Color3.fromRGB(55, 50, 70)}):Play()
                TweenService:Create(ball, tInfo, {BackgroundColor3 = Color3.fromRGB(140, 135, 155)}):Play()
            else
                TweenService:Create(toggleBg, tInfo, {BackgroundColor3 = Theme.Accent}):Play()
                TweenService:Create(toggleStroke, tInfo, {Color = Theme.Accent}):Play()
                TweenService:Create(ball, tInfo, {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            end
        end
    end

    frame.MouseEnter:Connect(function() updateVisuals(true) end)
    frame.MouseLeave:Connect(function() updateVisuals(false) end)

    toggleBg.MouseButton1Click:Connect(function()
        state = not state
        local tInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        if state then
            TweenService:Create(toggleBg, tInfo, {BackgroundColor3 = Theme.Accent}):Play()
            TweenService:Create(toggleStroke, tInfo, {Color = Theme.Accent}):Play()
            TweenService:Create(ball, tInfo, {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        else
            TweenService:Create(toggleBg, tInfo, {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(toggleStroke, tInfo, {Color = Color3.fromRGB(255, 255, 255)}):Play()
            TweenService:Create(ball, tInfo, {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Color3.fromRGB(20, 20, 25)}):Play()
        end
        callback(state)
    end)
    return frame
end

