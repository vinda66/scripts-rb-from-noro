else
TweenService:Create(toggleBg, tInfo, {BackgroundColor3 = activeColor}):Play()
TweenService:Create(toggleStroke, tInfo, {Color = activeColor}):Play()
TweenService:Create(ball, tInfo, {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
end
end
end
frame.MouseEnter:Connect(function() updateVisuals(true) end)
frame.MouseLeave:Connect(function() updateVisuals(false) end)
