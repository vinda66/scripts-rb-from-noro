if handle then
local mouseRay = Camera:ViewportPointToRay(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2, 0)
local raycastResult = workspace:Raycast(mouseRay.Origin, mouseRay.Direction * 1000)
local hitPos = raycastResult and raycastResult.Position or (mouseRay.Origin + mouseRay.Direction * 500)
createLaserBeam(handle.Position, hitPos)
end
end)
end
end
