else
TweenService:Create(toggleStroke, tInfo, {Color = Color3.fromRGB(255, 255, 255)}):Play()
end
else
TweenService:Create(label, tInfo, {TextColor3 = Color3.fromRGB(200, 195, 210)}):Play()
TweenService:Create(frame, tInfo, {BackgroundColor3 = Color3.fromRGB(18, 16, 24)}):Play()
TweenService:Create(frameStroke, tInfo, {Color = Color3.fromRGB(35, 32, 45)}):Play()
if not state then
TweenService:Create(toggleBg, tInfo, {BackgroundColor3 = Color3.fromRGB(32, 30, 42)}):Play()
TweenService:Create(toggleStroke, tInfo, {Color = Color3.fromRGB(55, 50, 70)}):Play()
TweenService:Create(ball, tInfo, {BackgroundColor3 = Color3.fromRGB(140, 135, 155)}):Play()
else
TweenService:Create(toggleBg, tInfo, {BackgroundColor3 = activeAccent}):Play()
TweenService:Create(toggleStroke, tInfo, {Color = activeAccent}):Play()
TweenService:Create(ball, tInfo, {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}):Play()
end
end
end
frame.MouseEnter:Connect(function() updateVisuals(true) end)
