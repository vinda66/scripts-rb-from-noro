local function showTab(tabName)
    _G.currentTab = tabName
    for name, page in pairs(Pages) do page.Visible = (name == tabName) end
    for _, btn in ipairs(Sidebar:GetChildren()) do
        if btn:IsA("TextButton") and btn.Name:find("TabBtn") then
            if btn.Name == tabName .. "TabBtn" then
                TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.2, TextColor3 = Theme.TextWhite}):Play()
            else
                TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0,0,0), BackgroundTransparency = 1, TextColor3 = Theme.TextMuted}):Play()
            end
        end
    end
