local function createStyledButton(text, yPosition)
    local button = Instance.new("TextButton")
    button.Parent = MainFrame
    button.BackgroundColor3 = Color3.fromRGB(28, 25, 35)
    button.Position = UDim2.new(0.05, 0, 0, yPosition + 30)
    button.Size = UDim2.new(0.9, 0, 0, 42)
    button.Text = text
    button.TextColor3 = Color3.fromRGB(220, 220, 230)
    button.TextSize = 14
    button.Font = Enum.Font.GothamSemibold
    addCorners(button, 10)
    addStroke(button, Color3.fromRGB(65, 55, 80), 1)
    return button
end

local function setButtonState(button, active)
    if active then
        button.BackgroundColor3 = Color3.fromRGB(120, 40, 210)
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        button:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(200, 130, 255)
    else
        button.BackgroundColor3 = Color3.fromRGB(28, 25, 35)
        button.TextColor3 = Color3.fromRGB(220, 220, 230)
        button:FindFirstChildOfClass("UIStroke").Color = Color3.fromRGB(65, 55, 80)
    end
end

local function getEquippedItem(plr)
    if plr.Character then
        for _, obj in ipairs(plr.Character:GetChildren()) do
            if obj:IsA("Tool") then return "[" .. obj.Name .. "]" end
        end
    end
    return "[Hands]"
end

