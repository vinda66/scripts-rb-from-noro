local TracersButton = createStyledButton("Toggle Tracers", 110)
local tracersToggle = false
local tracerObjects = {}
local function createLookTracer(plr)
if plr == game.Players.LocalPlayer then return end
local function addTracer(char)
if not tracersToggle then return end
local head = char:WaitForChild("Head", 5)
if head then
local attachmentStart = Instance.new("Attachment")
attachmentStart.Name = "TracerStart"
attachmentStart.Parent = head
local endPart = Instance.new("Part")
endPart.Name = "TracerEndPart"
endPart.Size = Vector3.new(0.1, 0.1, 0.1)
endPart.Transparency = 1; endPart.CanCollide = false; endPart.Anchored = true
endPart.Parent = char
local attachmentEnd = Instance.new("Attachment")
attachmentEnd.Name = "TracerEnd"
attachmentEnd.Parent = endPart
local beam = Instance.new("Beam")
beam.Name = "LookTracer"
beam.FaceCamera = true
beam.Width0 = 0.12; beam.Width1 = 0.04
beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
beam.Transparency = NumberSequence.new(0.05, 0.5)
beam.Attachment0 = attachmentStart; beam.Attachment1 = attachmentEnd
beam.Parent = head
local updateConn = RunService.RenderStepped:Connect(function()
if char and head and endPart and beam then
endPart.Position = head.Position + (head.CFrame.LookVector * 525)
end
end)
table.insert(tracerObjects, updateConn)
end
end
if plr.Character then addTracer(plr.Character) end
plr.CharacterAdded:Connect(addTracer)
end
local function clearTracers()
for _, conn in ipairs(tracerObjects) do if conn then conn:Disconnect() end end
tracerObjects = {}
for _, plr in game.Players:GetPlayers() do
if plr.Character then
local endPart = plr.Character:FindFirstChild("TracerEndPart")
if endPart then endPart:Destroy() end
local head = plr.Character:FindFirstChild("Head")
if head then
if head:FindFirstChild("TracerStart") then head.TracerStart:Destroy() end
if head:FindFirstChild("LookTracer") then head.LookTracer:Destroy() end
end
end
end
end
TracersButton.MouseButton1Click:Connect(function()
tracersToggle = not tracersToggle
setButtonState(TracersButton, tracersToggle)
if tracersToggle then
for _, plr in game.Players:GetPlayers() do createLookTracer(plr) end
else clearTracers() end
end)
