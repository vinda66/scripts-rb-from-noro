local EspButton = createStyledButton("Toggle ESP", 55)
local espToggle = false
local espObjects = {}

local function createESP(plr)
    if plr == game.Players.LocalPlayer then return end
    local function addHighlight(char)
        if not espToggle then return end
        if char:FindFirstChild("ESPHighlight") then char.ESPHighlight:Destroy() end
        
        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.Parent = char
        highlight.FillColor = Color3.fromRGB(140, 20, 250)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(210, 150, 255)
        highlight.OutlineTransparency = 0
        
        local head = char:WaitForChild("Head", 5)
        if head then
            local billboard = Instance.new("BillboardGui")
            billboard.Name = "ESPName"
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.new(0, 200, 0, 60)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.Parent = head
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, 0, 0, 20)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = plr.Name .. " [0m]"
            nameLabel.TextColor3 = Color3.fromRGB(220, 180, 255)
            nameLabel.TextSize = 13
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextStrokeTransparency = 0.3
            nameLabel.Parent = billboard

            local invLabel = Instance.new("TextLabel")
            invLabel.Position = UDim2.new(0, 0, 0, 20)
            invLabel.Size = UDim2.new(1, 0, 0, 18)
            invLabel.BackgroundTransparency = 1
            invLabel.Text = getEquippedItem(plr)
            invLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            invLabel.TextSize = 11
            invLabel.Font = Enum.Font.GothamSemibold
            invLabel.TextStrokeTransparency = 0.5
            invLabel.Parent = billboard

            local updateConn = RunService.RenderStepped:Connect(function()
                if char and head and billboard and nameLabel and invLabel and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
                    local distanceEnd = (head.Position - LocalPlayer.Character.Head.Position).Magnitude
                    local distanceMeters = math.round(distanceEnd / 3.5)
                    nameLabel.Text = plr.Name .. " [" .. tostring(distanceMeters) .. "m]"
                    invLabel.Text = getEquippedItem(plr)
                end
            end)
            table.insert(espObjects, updateConn)
        end
    end
    if plr.Character then addHighlight(plr.Character) end
    local conn = plr.CharacterAdded:Connect(addHighlight)
    table.insert(espObjects, conn)
end

local function clearESP()
    for _, conn in ipairs(espObjects) do if conn then conn:Disconnect() end end
    espObjects = {}
    for _, plr in game.Players:GetPlayers() do
        if plr.Character then
            local hl = plr.Character:FindFirstChild("ESPHighlight")
            if hl then hl:Destroy() end
local head = plr.Character:FindFirstChild("Head")
if head and head:FindFirstChild("ESPName") then head.ESPName:Destroy() end
end
end
end
EspButton.MouseButton1Click:Connect(function()
espToggle = not espToggle
setButtonState(EspButton, espToggle)
if espToggle then
for _, plr in game.Players:GetPlayers() do createESP(plr) end
game.Players.PlayerAdded:Connect(createESP)
else clearESP() end
end)
