-- 3. ЛОГИКА ПЕРЕКЛЮЧЕНИЯ ВКЛАДОК С АНИМАЦИЕЙ --
local function selectTab(activePage, activeBtn)
    pageMain.Visible = false
    pageVisuals.Visible = false
    pageSettings.Visible = false
    
    local tabAnim = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    TweenService:Create(tabMainBtn, tabAnim, {BackgroundColor3 = Color3.fromRGB(35, 35, 42)}):Play()
    TweenService:Create(tabVisualBtn, tabAnim, {BackgroundColor3 = Color3.fromRGB(35, 35, 42)}):Play()
    TweenService:Create(tabSettingsBtn, tabAnim, {BackgroundColor3 = Color3.fromRGB(35, 35, 42)}):Play()
    
    activePage.Visible = true
    TweenService:Create(activeBtn, tabAnim, {BackgroundColor3 = Color3.fromRGB(65, 65, 80)}):Play()
end

-- Восстановленные обработчики кликов по вкладкам
tabMainBtn.MouseButton1Click:Connect(function()
    selectTab(pageMain, tabMainBtn)
end)

tabVisualBtn.MouseButton1Click:Connect(function()
    selectTab(pageVisuals, tabVisualBtn)
end)

tabSettingsBtn.MouseButton1Click:Connect(function()
    selectTab(pageSettings, tabSettingsBtn)
end)

-- 4. ПЕРЕТАСКИВАНИЕ ТОЛЬКО ЗА ЗАГОЛОВОК (title) --
local dragging, dragInput, dragStart, startPos
title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)
title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- 5. ПЛАВНОЕ СВОРАЧИВАНИЕ НА ПРАВЫЙ CTRL --
local isMenuOpen = true
local isAnimating = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or isAnimating then return end
    
    if input.KeyCode == Enum.KeyCode.RightControl then
        isAnimating = true
        isMenuOpen = not isMenuOpen

        if isMenuOpen then
            frame.Visible = true
            frame.Size = UDim2.new(0, 0, 0, 0)
            local openTween = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 650, 0, 400)
            })
            openTween:Play()
            openTween.Completed:Wait()
        else
            local closeTween = TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0)
            })
            closeTween:Play()
            closeTween.Completed:Wait()
            frame.Visible = false
        end

        isAnimating = false
    end
end)

-- 6. ФУНКЦИЯ УВЕДОМЛЕНИЙ НА ЭКРАНЕ --
local function showNotification(notifTitle, notifText)
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 240, 0, 60)
    notif.Position = UDim2.new(1, 20, 1, -75)
    notif.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    notif.BorderSizePixel = 0
    notif.Parent = Gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notif

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(70, 70, 85)
    stroke.Thickness = 1.5
    stroke.Parent = notif

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -20, 0, 22)
    titleLbl.Position = UDim2.new(0, 10, 0, 6)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = notifTitle
    titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 14
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = notif

    local descLbl = Instance.new("TextLabel")
    descLbl.Size = UDim2.new(1, -20, 0, 22)
    descLbl.Position = UDim2.new(0, 10, 0, 28)
    descLbl.BackgroundTransparency = 1
    descLbl.Text = notifText
    descLbl.TextColor3 = Color3.fromRGB(180, 180, 195)
    descLbl.Font = Enum.Font.Gotham
    descLbl.TextSize = 13
    descLbl.TextXAlignment = Enum.TextXAlignment.Left
    descLbl.Parent = notif

    local slideIn = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -255, 1, -75)
    })
    slideIn:Play()

    task.delay(3, function()
        if notif and notif.Parent then
            local slideOut = TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(1, 20, 1, -75)
            })
            slideOut:Play()
            slideOut.Completed:Wait()
            notif:Destroy()
        end
    end)
end

-- 7. ФУНКЦИЯ СОЗДАНИЯ ПЕРЕКЛЮЧАТЕЛЕЙ С АНИМАЦИЕЙ --
local function createToggle(parentPage, text, posX, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 180, 0, 36)
    btn.Position = UDim2.new(0, posX, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    btn.Text = text .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 14
    btn.AutoButtonColor = false
    btn.Parent = parentPage

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = btn
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(70, 70, 85)
stroke.Thickness = 1
stroke.Parent = btn
local enabled = false
local animInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
btn.MouseEnter:Connect(function()
if not enabled then
TweenService:Create(btn, animInfo, {BackgroundColor3 = Color3.fromRGB(52, 52, 62)}):Play()
end
end)
btn.MouseLeave:Connect(function()
if not enabled then
TweenService:Create(btn, animInfo, {BackgroundColor3 = Color3.fromRGB(40, 40, 48)}):Play()
end
end)
btn.MouseButton1Click:Connect(function()
enabled = not enabled
if enabled then
btn.Text = text .. ": ON"
TweenService:Create(btn, animInfo, {BackgroundColor3 = Color3.fromRGB(45, 150, 75), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
TweenService:Create(stroke, animInfo, {Color = Color3.fromRGB(70, 200, 100)}):Play()
else
btn.Text = text .. ": OFF"
TweenService:Create(btn, animInfo, {BackgroundColor3 = Color3.fromRGB(40, 40, 48), TextColor3 = Color3.fromRGB(220, 220, 220)}):Play()
TweenService:Create(stroke, animInfo, {Color = Color3.fromRGB(70, 70, 85)}):Play()
end
callback(enabled)
end)
end
